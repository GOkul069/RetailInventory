	column 'Sales 52w' = CALCULATE(SUM('Inventory Weekly'[Net Sales]))
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: 31f5dcc4-0d65-56fe-8179-2eedce8f5426
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Pareto on 52-week net sales: A = first 80%, B = next 15%, C = the tail.
	column 'ABC Class' =
			VAR MySales = Products[Sales 52w]
			VAR Total = SUM(Products[Sales 52w])
			VAR Running = SUMX(FILTER(Products, Products[Sales 52w] >= MySales), Products[Sales 52w])
			VAR Share = DIVIDE(Running, Total)
			RETURN
			    SWITCH(TRUE(), Share <= 0.8, "A", Share <= 0.95, "B", "C")
		dataType: string
		lineageTag: ac276497-d95f-5b24-b14c-56bf385b0fa6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Demand variability: coefficient of variation of chain-wide weekly units. X < 0.3, Y < 0.5, Z otherwise.
	column 'XYZ Class' =
			VAR Weekly =
			    ADDCOLUMNS(
			        VALUES('Inventory Weekly'[Week Ending]),
			        "@Units", CALCULATE(SUM('Inventory Weekly'[Units Sold]))
			    )
			VAR CV = DIVIDE(STDEVX.P(Weekly, [@Units]), AVERAGEX(Weekly, [@Units]))
			RETURN
			    SWITCH(TRUE(), CV < 0.3, "X", CV < 0.5, "Y", "Z")
		dataType: string
		lineageTag: e4995a19-f1be-5eb1-ba0a-90400412d925
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter = ",", Encoding = 65001, Columns = 9, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // the product master is hand-maintained: category casing and trailing spaces vary
				    Cleaned = Table.TransformColumns(
				        Promoted,
				        {{"Category", each Text.Proper(Text.Trim(_)), type text}, {"ProductName", Text.Trim, type text}, {"Supplier", Text.Trim, type text}}
				    ),
				    // prices arrive as text like "$1,249.00"
				    Money = Table.TransformColumns(
				        Cleaned,
				        {{"UnitCost", each Number.From(Text.Remove(_, {"$", ","}), "en-US"), type number},
				         {"RetailPrice", each Number.From(Text.Remove(_, {"$", ","}), "en-US"), type number}}
				    ),
				    Typed = Table.TransformColumnTypes(Money, {{"CasePack", Int64.Type}, {"LeadTimeDays", Int64.Type}}, "en-US"),
				    Margin = Table.AddColumn(Typed, "IMU %", each 1 - [UnitCost] / [RetailPrice], type number),
				    PriceBand = Table.AddColumn(Margin, "Price Band", each
				        if [RetailPrice] < 25 then "Under $25" else if [RetailPrice] < 75 then "$25-75"
				        else if [RetailPrice] < 150 then "$75-150" else "$150+", type text),
				    Renamed = Table.RenameColumns(PriceBand, {{"ProductName", "Product"}, {"UnitCost", "Unit Cost"}, {"RetailPrice", "Retail Price"},
				                                             {"CasePack", "Case Pack"}, {"LeadTimeDays", "Lead Time Days"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
