		summarizeBy: average
		sourceColumn: Days Late

		annotation SummarizationSetBy = Automatic

	partition 'Purchase Orders' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "purchase_orders.csv"), [Delimiter = ",", Encoding = 65001, Columns = 9, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"ReceivedDate", "ReceivedQty"}),
				    Typed = Table.TransformColumnTypes(
				        Blanks,
				        {{"OrderDate", type date}, {"ExpectedDate", type date}, {"ReceivedDate", type date}, {"OrderedQty", Int64.Type}, {"ReceivedQty", Int64.Type}},
				        "en-US"
				    ),
				    IsOpen = Table.AddColumn(Typed, "Is Open", each if [ReceivedDate] = null then 1 else 0, Int64.Type),
				    OnTime = Table.AddColumn(IsOpen, "On Time", each if [ReceivedDate] = null then null else if [ReceivedDate] <= [ExpectedDate] then 1 else 0, Int64.Type),
				    InFull = Table.AddColumn(OnTime, "In Full", each if [ReceivedQty] = null then null else if [ReceivedQty] >= [OrderedQty] then 1 else 0, Int64.Type),
				    DaysLate = Table.AddColumn(InFull, "Days Late", each if [ReceivedDate] = null then null else List.Max({0, Duration.Days([ReceivedDate] - [ExpectedDate])}), Int64.Type),
				    Renamed = Table.RenameColumns(DaysLate, {{"PONumber", "PO Number"}, {"StoreID", "Store ID"}, {"OrderDate", "Order Date"},
				        {"ExpectedDate", "Expected Date"}, {"ReceivedDate", "Received Date"}, {"OrderedQty", "Ordered Qty"}, {"ReceivedQty", "Received Qty"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
